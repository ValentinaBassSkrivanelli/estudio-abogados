# Copiá este archivo como .env.local y completá los valores.

# URL pública del sitio (para links compartidos por WhatsApp y SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto: envío de mails con Resend (https://resend.com)
RESEND_API_KEY=
# Casilla que recibe las consultas
CONTACT_TO_EMAIL=
# Remitente (con un dominio verificado en Resend). Si lo dejás vacío se usa onboarding@resend.dev
CONTACT_FROM_EMAIL=
